# demo-reminder Publisher。复制成 .env 后填写，chmod 600，不要提交。

DEMO_REMINDER_IMAGE=autoqq-demo-reminder:0.1.0

# 与 EventServer 中注册的 Publisher 身份一致，至少 32 字符
PUBLISHER_TOKEN=

# 演示入口的 Bearer Token，至少 16 字符；缺失时容器拒绝启动
INGRESS_TOKEN=

EVENTSERVER_URL=http://autoqq-eventserver-api:8080

# 缺省延迟（秒）与允许的最大延迟（秒）
DEFAULT_DELAY_SECONDS=300
MAX_DELAY_SECONDS=3600
REQUEST_TIMEOUT_SECONDS=10
DISPLAY_TIMEZONE=Asia/Shanghai

# 演示入口在宿主机上的发布端口
DEMO_REMINDER_PORT=18090

# 容器需要接入的网络名（外部网络）
HERMES_DOCKER_NETWORK=hermes_net

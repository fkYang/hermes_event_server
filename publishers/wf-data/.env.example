# wf-data Publisher。复制成 .env 后填写，chmod 600，不要提交。

WFDATA_PUBLISHER_IMAGE=autoqq-wfdata-publisher:0.1.1

# 与 EventServer 中注册的 Publisher 身份一致，至少 32 字符
WFDATA_PUBLISHER_TOKEN=

WF_DATA_URL=http://wf-data:8080/warframe/cetus/tent-bounties
EVENTSERVER_URL=http://autoqq-eventserver-api:8080

WFDATA_POLL_SECONDS=60
WFDATA_LEAD_SECONDS=300

# 容器需要接入的网络名（外部网络）
HERMES_DOCKER_NETWORK=hermes_net
WF_DATA_DOCKER_NETWORK=my_web_net

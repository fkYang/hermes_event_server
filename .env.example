INITIAL_ADMIN_OPENIDS=
DEFAULT_TIMEZONE=Asia/Shanghai
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_DEFAULT_LEASE_SECONDS=60
DELIVERY_MAX_SCHEDULE_HORIZON_SECONDS=86400

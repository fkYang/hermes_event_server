MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=autoqq
MYSQL_USER=autoqq
MYSQL_PASSWORD=replace-locally-do-not-commit
MYSQL_CHARSET=utf8mb4

